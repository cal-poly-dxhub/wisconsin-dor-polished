{
  "name": "wisconsin-sst",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "infra",
    "frontend"
  ],
  "scripts": {
    "build": "bun run --filter='*' build",
    "dev": "bun run --filter='*' dev",
    "pytest": "uv run pytest",
    "test": "bun run --elide-lines=0 --filter='*' test",
    "deploy": "bun run bundle && bun run --elide-lines=0 --filter='infra' deploy",
    "first-time": "uv run python tools/upload_model_configs.py && bash tools/ingestion/scripts/sync_faq_bucket.sh",
    "destroy": "bun run --elide-lines=0 --filter='infra' destroy",
    "bundle": "uv run tools/bundle.py",
    "stream": "sh -c 'aws logs tail /aws/lambda/$1 --follow' --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-cdk/cloud-assembly-schema": "^49.4.0"
  },
  "engines": {
    "bun": "1.2.19"
  },
  "overrides": {
    "postcss": "^8.5.31"
  }
}
